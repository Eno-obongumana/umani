<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>UMANI Report — {{ target }}</title>
<style>
  body { font-family: -apple-system, system-ui, sans-serif; max-width: 1000px;
         margin: 2rem auto; padding: 0 1rem; color: #1a1a1a; line-height: 1.5; }
  h1 { border-bottom: 2px solid #333; padding-bottom: .5rem; }
  h2 { margin-top: 2rem; color: #333; }
  .meta { color: #666; font-size: 0.9rem; margin-bottom: 2rem; }
  .summary { display: flex; gap: 1rem; margin: 2rem 0; flex-wrap: wrap; }
  .card { flex: 1; min-width: 120px; padding: 1rem; border-radius: 6px;
          text-align: center; color: #fff; }
  .card .count { font-size: 2rem; font-weight: bold; }
  .card .label { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px; }
  .critical { background: #7f1d1d; }
  .high     { background: #b91c1c; }
  .medium   { background: #b45309; }
  .low      { background: #0369a1; }
  .info     { background: #4b5563; }
  .finding { border: 1px solid #e5e5e5; border-radius: 6px; padding: 1rem;
             margin: 1rem 0; background: #fafafa; }
  .finding h3 { margin: 0 0 .5rem 0; }
  .badge { display: inline-block; padding: 2px 8px; border-radius: 4px;
           font-size: 0.75rem; font-weight: bold; color: #fff;
           margin-right: .5rem; text-transform: uppercase; }
  .evidence { background: #f0f0f0; border-left: 3px solid #999;
              padding: .5rem .75rem; font-family: ui-monospace, monospace;
              font-size: 0.85rem; white-space: pre-wrap; word-break: break-all;
              margin: .5rem 0; }
  .section-label { font-weight: bold; color: #555; margin-top: .75rem; }
  .url { color: #0369a1; word-break: break-all; }
  footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #ddd;
           color: #888; font-size: 0.85rem; }
</style>
</head>
<body>

<h1>UMANI Security Report</h1>
<div class="meta">
  <div><strong>Target:</strong> <span class="url">{{ target }}</span></div>
  <div><strong>Scan ID:</strong> {{ scan_id }}</div>
  <div><strong>Generated:</strong> {{ generated_at }}</div>
  <div><strong>Total findings:</strong> {{ total }}</div>
</div>

<h2>Executive Summary</h2>
<div class="summary">
  <div class="card critical"><div class="count">{{ counts.critical }}</div><div class="label">Critical</div></div>
  <div class="card high"><div class="count">{{ counts.high }}</div><div class="label">High</div></div>
  <div class="card medium"><div class="count">{{ counts.medium }}</div><div class="label">Medium</div></div>
  <div class="card low"><div class="count">{{ counts.low }}</div><div class="label">Low</div></div>
  <div class="card info"><div class="count">{{ counts.info }}</div><div class="label">Info</div></div>
</div>

<h2>Findings</h2>
{% for f in findings %}
<div class="finding">
  <h3>
    <span class="badge {{ f.severity }}">{{ f.severity }}</span>
    {{ f.name }}
  </h3>
  <div><strong>Module:</strong> {{ f.module }}</div>
  <div><strong>URL:</strong> <span class="url">{{ f.url }}</span></div>
  {% if f.param %}<div><strong>Parameter:</strong> {{ f.param }}</div>{% endif %}
  {% if f.cvss %}<div><strong>CVSS:</strong> {{ f.cvss }}</div>{% endif %}

  <div class="section-label">Evidence</div>
  <div class="evidence">{{ f.evidence }}</div>

  <div class="section-label">Description</div>
  <div>{{ f.description }}</div>

  <div class="section-label">Remediation</div>
  <div>{{ f.remediation }}</div>
</div>
{% endfor %}

<footer>
  Generated by UMANI — a modular web security testing framework.<br>
  For authorized testing only. See ETHICS.md.
</footer>

</body>
</html>
